# Names only. Values live in the environment's secrets or a local .env, never in git.

# Phase 1: deploying the registry (npx tsx scripts/deploy-registry.ts sepolia)
DEPLOYER_PRIVATE_KEY=
ISSUER_ADDRESS=
ISSUER_ORG_NAME=
ETHERSCAN_API_KEY=
# Hours a revocation waits before it takes effect, during which the owner may cancel it (#95). Default 24; at least 1.
REVOCATION_DELAY_HOURS=

# Phase 1+: talking to Sepolia
SEPOLIA_RPC_URL=
# The worker's second endpoint, from another provider: a row is settled only on
# what both read (#92). Any network: <NETWORK>_RPC_URL_2.
SEPOLIA_RPC_URL_2=
# Phase 6: the production candidates' testnets (and, once chosen, the chain
# itself): <NETWORK>_RPC_URL, as in src/lib/chain/networks.ts
BASE_SEPOLIA_RPC_URL=
OPTIMISM_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
MAINNET_RPC_URL=
BASE_RPC_URL=
OPTIMISM_RPC_URL=
ARBITRUM_RPC_URL=
# Optional, for scripts/measure-chain-costs.ts: MEASURE_RPC_<MAINNET|BASE|OPTIMISM|ARBITRUM>

# Phase 3: anchoring. The app needs ANCHOR_NETWORK (sepolia or local) and
# ISSUER_ADDRESS; only the worker (npm run worker) reads ISSUER_PRIVATE_KEY.
ANCHOR_NETWORK=
ISSUER_PRIVATE_KEY=
# Phase 6: SIGNER=kms signs with a Cloud KMS key version instead of
# ISSUER_PRIVATE_KEY (which must then be unset): KMS_KEY_NAME is the version's
# full name, credentials are the host's (docs/runbooks/kms-key.md).
SIGNER=
KMS_KEY_NAME=
# For ANCHOR_NETWORK=local: an Anvil node (default http://127.0.0.1:8545)
LOCAL_RPC_URL=
# Optional: a second local endpoint for the worker (default: LOCAL_RPC_URL)
LOCAL_RPC_URL_2=
# Pause between worker passes (default 15000)
WORKER_INTERVAL_MS=
# The app's public origin; stamped copies and certificates point at <origin>/verify.
# The worker also needs FILE_ENCRYPTION_KEY, FILE_ENCRYPTION_KEY_VERSION and FILE_STORAGE_DIR.
APP_PUBLIC_URL=
# Optional: a deployment record other than deployments/<ANCHOR_NETWORK>.json
DEPLOYMENT_FILE=

# Phase 4: the public verifier (/verify, /r/<familyId>/latest). VERIFY_NETWORK
# defaults to ANCHOR_NETWORK. The two RPC URLs are sent to every visitor's
# browser: use two public, keyless https endpoints run by different providers,
# never a URL that carries a private API key. For local both default to
# LOCAL_RPC_URL.
VERIFY_NETWORK=
VERIFY_RPC_URL_1=
VERIFY_RPC_URL_2=
# Optional: comma-separated re-anchor archives or proofs of retired registries
# whose roots are recorded on this one (#65). /verify fetches them from
# /reanchor/<n> for a file the registry holds no record of, and build:verifier
# bakes them in (#126). Public chain data; their paths are never sent.
REANCHOR_ARCHIVES=

# Phase 2: the app. docker-compose.yml runs Postgres with POSTGRES_PASSWORD;
# DATABASE_URL is then postgresql://anchor:<that password>@127.0.0.1:5432/anchor
POSTGRES_PASSWORD=
DATABASE_URL=
# Base64 of at least 32 random bytes: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# Base64 of exactly 32 random bytes; FILE_ENCRYPTION_KEY_VERSION names it (default 1)
FILE_ENCRYPTION_KEY=
FILE_ENCRYPTION_KEY_VERSION=
# Where encrypted PDFs are written (default ./storage, git-ignored)
FILE_STORAGE_DIR=
# Base64 of at least 32 random bytes; keys the pseudonymous family ids
ISSUER_FAMILY_SECRET=
# 1 only behind a proxy that overwrites X-Forwarded-For
TRUST_PROXY_HEADERS=

# Phase 2: npm run db:seed
SEED_ORG_NAME=
SEED_PREPARER_EMAIL=
SEED_PREPARER_PASSWORD=
SEED_APPROVER_EMAIL=
SEED_APPROVER_PASSWORD=
# Optional: an admin (sets up two-step sign-in at first sign-in) and a read-only viewer
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_VIEWER_EMAIL=
SEED_VIEWER_PASSWORD=
# Development and CI only: turn the approver's and the admin's two-step sign-in
# on with these base32 secrets, so tests can compute their codes. Never set
# them in production.
SEED_APPROVER_TOTP_SECRET=
SEED_ADMIN_TOTP_SECRET=

# Phase 2: npm run test:db (the database name must end in _test)
TEST_DATABASE_URL=

# Phase 5: npm run mailer (the recipients' email). Development: Mailpit from
# docker-compose.yml, SMTP_URL=smtp://127.0.0.1:1025. Production: smtps://,
# with the credentials in the URL, which is never logged.
SMTP_URL=
MAIL_FROM=
# Optional: milliseconds between passes (default 30000)
MAILER_INTERVAL_MS=
# #66: npm run ots (OpenTimestamps). Optional: milliseconds between passes (default 300000)
OTS_INTERVAL_MS=
# Phase 5: scripts/backup.sh writes here (docs/operations.md)
BACKUP_DIR=
# The end-to-end tests read the email from Mailpit's API (default http://127.0.0.1:8025)
MAILPIT_URL=
# Phase 6: scripts/owner-call.ts --send, while the registry's owner is still a
# single key (Anvil, a testnet rehearsal). Never set where the owner is a Safe.
OWNER_PRIVATE_KEY=
# #70: the firm's electronic seal on distribution copies, for the worker only
# (docs/operations.md, "The electronic seal"). csc to seal; none (the default) not to.
SEAL_PROVIDER=
CSC_URL=
# Optional: an OAuth 2.0 token endpoint; without it, the API's auth/login with HTTP Basic
CSC_TOKEN_URL=
CSC_CLIENT_ID=
CSC_CLIENT_SECRET=
CSC_CREDENTIAL_ID=
# Optional: the credential's PIN, when the provider asks for one
CSC_PIN=
TSA_URL=
# Optional: HTTP Basic at the timestamping authority, and the policy to ask for
TSA_USERNAME=
TSA_PASSWORD=
TSA_POLICY=
# A PEM file of the roots the seal and the timestamping authority must chain to.
# Public: the app hands them to /verify, and build:verifier bakes them in (#120).
SEAL_TRUST_ANCHORS=
# B-LT (the default): each copy also carries its certificates' status, fetched
# from the OCSP responders and CRLs they name (#119); or B-T
SEAL_LEVEL=
