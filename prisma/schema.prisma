// The issuer's own records. Nothing here goes on chain; the chain only ever
// sees the commitments computed from it (CLAUDE.md rule 1). Free text that is
// confidential (the opinion, the manifest, what the parser extracted) is
// stored AES-256-GCM encrypted (src/lib/sealed.ts), never in clear.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Who may do what is one table in src/lib/roles.ts. APPROVER and ADMIN sign
/// in with a second factor.
enum Role {
  ADMIN
  PREPARER
  APPROVER
  VIEWER
}

enum ReportType {
  STANDALONE
  CONSOLIDATED
}

enum OpinionType {
  UNMODIFIED
  QUALIFIED
  ADVERSE
  DISCLAIMER
}

enum VersionStatus {
  DRAFT
  CONFIRMED
  /// A second person approved it; its anchor is queued (CLAUDE.md rule 6).
  APPROVED
  /// The original's anchor is final.
  ANCHORED
  /// The stamped copy's anchor is final too (Phase 3b).
  COMPLETE
  /// Withdrawn: the original's revocation is in effect at a final block.
  REVOKED
}

/// Inflect's write ladder, one rung at a time.
enum ChainWriteMode {
  DISABLED
  DRY_RUN
  LIVE
}

enum ChainWriteKind {
  ANCHOR
  ANCHOR_COPY
  REVOKE
  /// The hash of the firm's latest audit event, written nightly so the log's
  /// history is held to something outside the database (#94).
  AUDIT_HEAD
}

enum ChainWriteStatus {
  /// Written before any network call (CLAUDE.md rule 3).
  INTENT
  /// DRY_RUN only: simulated, never broadcast.
  SIMULATED
  /// Signed and sent; waiting for the block to be finalized.
  BROADCAST
  FINAL
  FAILED
  /// The outcome is unknown; settled only by reading the chain, never by resending.
  INDETERMINATE
}

/// Why a version is withdrawn. On chain it is a number (REVOCATION_CODES in
/// src/lib/revocation/reasons.ts): 1, 2, 3 and 9.
enum RevocationReason {
  WITHDRAWN
  ISSUED_IN_ERROR
  SUPERSEDED_AND_WITHDRAWN
  OTHER
}

enum RevocationStatus {
  /// An admin asked for it; it waits for an approver who is someone else.
  REQUESTED
  /// Approved: its REVOKE write is in the journal.
  APPROVED
  /// Its request is on chain, in a final block, and waits out the registry's
  /// delay (#95) until `effectiveAt`. The registry's owner may still cancel it.
  SCHEDULED
  /// In effect at a final block: terminal.
  REVOKED
  /// An approver turned it down.
  REJECTED
  /// The admin who asked took it back before it was approved.
  WITHDRAWN
  /// The registry's owner cancelled it on chain before it took effect.
  CANCELLED
}

/// What a notice tells its recipient (#96).
enum NotificationKind {
  /// A newer version supersedes the one they hold; the notice's version is the newer one.
  SUPERSEDED
  /// A version of the report is revoked; the notice's version is the revoked one.
  REVOKED
}

enum NotificationStatus {
  PENDING
  SENT
  /// Gave up after the last attempt; a person looks at it.
  FAILED
  /// The recipient was removed before it was sent.
  CANCELLED
}

/// Where a version's OpenTimestamps proof stands (#66).
enum OtsStatus {
  /// Calendars hold the digest; Bitcoin has not confirmed it yet.
  PENDING
  /// A Bitcoin attestation in the proof was checked against two explorers.
  COMPLETE
  /// The proof leads to something no block holds: a person looks at it.
  BROKEN
}

enum ReasonCode {
  INITIAL
  CORRECTION
  SUBSEQUENT_EVENT
  OTHER
}

/// The audit firm. One for the prototype (#5); everything hangs off it so a
/// second firm needs no schema change.
model IssuerOrg {
  id                String             @id @default(cuid())
  name              String
  chainWriteMode    ChainWriteMode     @default(DISABLED)
  createdAt         DateTime           @default(now())
  users             User[]
  clients           Client[]
  auditEvents       AuditEvent[]
  lookupCounts      LookupCount[]
  auditChecks       AuditChainCheck[]
  registryWatches   RegistryWatch[]
  unjournaledWrites UnjournaledWrite[]
  chainWrites       ChainWrite[]
}

model User {
  id                   String             @id @default(cuid())
  orgId                String
  org                  IssuerOrg          @relation(fields: [orgId], references: [id])
  email                String             @unique
  name                 String
  passwordHash         String
  role                 Role
  createdAt            DateTime           @default(now())
  engagements          Engagement[]
  prepared             ReportVersion[]    @relation("preparedBy")
  confirmed            ReportVersion[]    @relation("confirmedBy")
  approved             ReportVersion[]    @relation("approvedBy")
  revocationsRequested Revocation[]       @relation("revocationRequestedBy")
  revocationsApproved  Revocation[]       @relation("revocationApprovedBy")
  revocationsClosed    Revocation[]       @relation("revocationClosedBy")
  recipientsAdded      Recipient[]        @relation("recipientAddedBy")
  recipientsRemoved    Recipient[]        @relation("recipientRemovedBy")
  unjournaledReviewed  UnjournaledWrite[]

  /// The TOTP secret, sealed (context `User:<id>:totpSecret`); null until set up.
  totpSecret        Bytes?
  /// When the user confirmed their first code: the second factor is on from then.
  totpEnabledAt     DateTime?
  /// The last time step accepted, so no code is accepted twice.
  totpLastStep      Int?
  /// The sealed secret of a setup in progress (context `User:<id>:totpPendingSecret`).
  totpPendingSecret Bytes?
  recoveryCodes     RecoveryCode[]

  @@index([orgId])
}

/// One-time codes for a lost authenticator. Only SHA-256 of each code is
/// stored; the codes are shown once, when the second factor is set up.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Client {
  id                 String       @id @default(cuid())
  orgId              String
  org                IssuerOrg    @relation(fields: [orgId], references: [id])
  name               String
  /// Spaces removed and upper-cased, as the family key canonicalises it.
  registrationNumber String
  /// ISO 3166-1 alpha-2.
  country            String
  createdAt          DateTime     @default(now())
  engagements        Engagement[]

  @@unique([orgId, country, registrationNumber])
}

/// A report family: every version of one report (#6).
model Engagement {
  id            String          @id @default(cuid())
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id])
  /// The firm's own engagement reference, part of the family key.
  engagementRef String
  periodEnd     DateTime        @db.Date
  reportType    ReportType
  /// HMAC-SHA256 under ISSUER_FAMILY_SECRET (src/lib/commitments.ts).
  familyId      String          @unique
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  versions      ReportVersion[]
  recipients    Recipient[]

  @@unique([clientId, engagementRef, periodEnd, reportType])
}

model ReportVersion {
  id                      String         @id @default(cuid())
  engagementId            String
  engagement              Engagement     @relation(fields: [engagementId], references: [id])
  version                 Int
  reasonCode              ReasonCode
  status                  VersionStatus  @default(DRAFT)
  /// SHA-256 of the exact file; one file is one version, ever.
  docHash                 String         @unique
  pageCount               Int
  /// Signed or edit-protected: anchored as is, never rewritten (#74).
  anchorOnly              Boolean
  /// Parser flags: signed, javascript, embeddedFiles, xfa, editProtected.
  flags                   Json
  storedFileId            String         @unique
  storedFile              StoredFile     @relation("originalFile", fields: [storedFileId], references: [id])
  /// Sealed JSON: what the opinion locator found, or why it found nothing.
  extraction              Bytes
  // Set together, only when a person confirms (CLAUDE.md rule 6).
  opinionType             OpinionType?
  /// Sealed: the normalised opinion text the person confirmed.
  confirmedOpinion        Bytes?
  /// When the PDF holds several auditor's reports (#77): which one, counted
  /// from 0, the person chose to start from. Null when there was one, or none.
  opinionCandidate        Int?
  reportDate              DateTime?      @db.Date
  /// Fresh from the CSPRNG per version; unique, so a reused salt is refused.
  opinionSalt             Bytes?         @unique
  opinionCommitment       String?
  manifestSalt            Bytes?         @unique
  /// Sealed canonical JSON of manifest v1.
  manifest                Bytes?
  manifestHash            String?        @unique
  preparedById            String
  preparedBy              User           @relation("preparedBy", fields: [preparedById], references: [id])
  confirmedById           String?
  confirmedBy             User?          @relation("confirmedBy", fields: [confirmedById], references: [id])
  confirmedAt             DateTime?
  /// Never the preparer or the confirmer: a CHECK in the migration enforces it.
  approvedById            String?
  approvedBy              User?          @relation("approvedBy", fields: [approvedById], references: [id])
  approvedAt              DateTime?
  /// The original's record id on chain, once its anchor is final.
  recordId                String?        @unique
  anchorTxHash            String?
  anchorBlock             BigInt?
  // The distribution copy: the original with its anchor written into its
  // metadata as an incremental update (src/lib/stamp.ts). Never for anchorOnly.
  copyDocHash             String?        @unique
  copyStoredFileId        String?        @unique
  copyStoredFile          StoredFile?    @relation("copyFile", fields: [copyStoredFileId], references: [id], onDelete: Restrict)
  copyRecordId            String?        @unique
  copyTxHash              String?
  copyBlock               BigInt?
  /// When the copy carries the firm's electronic seal (#70): the time its timestamp vouches for.
  copySealedAt            DateTime?
  /// anchorOnly versions get a verification certificate instead of a copy.
  certificateStoredFileId String?        @unique
  certificateStoredFile   StoredFile?    @relation("certificateFile", fields: [certificateStoredFileId], references: [id], onDelete: Restrict)
  completedAt             DateTime?
  /// Set with REVOKED: the time the revocation took effect.
  revokedAt               DateTime?
  chainWrites             ChainWrite[]
  revocations             Revocation[]
  notifications           Notification[]
  otsProof                OtsProof?
  createdAt               DateTime       @default(now())

  @@unique([engagementId, version])
  @@index([preparedById])
  @@index([confirmedById])
  @@index([approvedById])
}

/// The journal of every chain write. A row exists before anything is sent.
/// Partial unique indexes in the migration allow at most one live (neither
/// FAILED nor SIMULATED) ANCHOR and ANCHOR_COPY row per version, one REVOKE row
/// in flight per version (a revocation the registry's owner cancelled leaves
/// its REVOKE FINAL, and the firm may ask again), and one row per nonce of an
/// issuer key, so two workers can never journal the same nonce.
model ChainWrite {
  id                   String           @id @default(cuid())
  orgId                String
  org                  IssuerOrg        @relation(fields: [orgId], references: [id])
  /// Every kind but AUDIT_HEAD writes for a report version (a CHECK holds it).
  reportVersionId      String?
  reportVersion        ReportVersion?   @relation(fields: [reportVersionId], references: [id], onDelete: Restrict)
  kind                 ChainWriteKind
  /// AUDIT_HEAD: the hash of the firm's audit event the check found last (#94).
  auditHead            String?
  status               ChainWriteStatus @default(INTENT)
  /// The org's mode when the row was written: a DRY_RUN row is never broadcast.
  mode                 ChainWriteMode
  chainId              Int
  registry             String
  issuer               String
  /// ANCHOR: the family's latest record, read when the transaction was built.
  parentId             String?
  recordId             String?
  nonce                Int?
  txHash               String?
  /// Hashes this write had before being replaced at the same nonce with a higher fee.
  replacedTxHashes     String[]         @default([])
  /// Kept so a replacement signs exactly the same call with the same gas.
  gasLimit             String?
  maxFeePerGas         String?
  maxPriorityFeePerGas String?
  blockNumber          BigInt?
  /// A named reason: the contract's error name, or the worker's.
  error                String?
  attempts             Int              @default(0)
  broadcastAt          DateTime?
  /// The worker holding this row; another may take it once this passes.
  leaseUntil           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([status, leaseUntil])
  @@index([reportVersionId])
  @@index([chainId, issuer])
  @@index([orgId, kind])
}

/// Append-only, hash-chained per organisation: each row's hash is
/// SHA-256(prevHash || canonical JSON of the event). A trigger in the
/// migration refuses UPDATE and DELETE.
model AuditEvent {
  id          BigInt    @id @default(autoincrement())
  orgId       String
  org         IssuerOrg @relation(fields: [orgId], references: [id])
  seq         Int
  /// ISO timestamp, set by the writer so the hash can cover it.
  at          String
  /// The user, or null for a background process (the worker, the mailer, the registry watch).
  actorId     String?
  action      String
  subjectType String
  subjectId   String
  data        Json
  prevHash    String
  hash        String    @unique

  @@unique([orgId, seq])
}

/// The issuer key's last balance check, and whether its endpoints last
/// disagreed, written by the worker and read by the console's banners. One row
/// per chain and key.
model IssuerKeyStatus {
  chainId        Int
  address        String
  balanceWei     String
  low            Boolean
  checkedAt      DateTime
  /// Set by a pass in which the worker's two RPC endpoints disagreed (#92), cleared by one in which they did not.
  rpcDisagreedAt DateTime?

  @@id([chainId, address])
}

/// An uploaded PDF, encrypted at rest under FILE_ENCRYPTION_KEY.
model StoredFile {
  id            String         @id @default(cuid())
  /// Relative to FILE_STORAGE_DIR.
  path          String         @unique
  iv            Bytes
  authTag       Bytes
  keyVersion    Int
  /// SHA-256 of the plaintext, checked again on every read.
  sha256        String
  size          Int
  createdAt     DateTime       @default(now())
  version       ReportVersion? @relation("originalFile")
  copyOf        ReportVersion? @relation("copyFile")
  certificateOf ReportVersion? @relation("certificateFile")
}

/// Lookups of a family's latest version (/r/<familyId>/latest) per UTC day,
/// counted for the firm that issued the family. A count and nothing else: no
/// family id, no address, no time of day.
model LookupCount {
  orgId String
  org   IssuerOrg @relation(fields: [orgId], references: [id])
  day   DateTime  @db.Date
  count Int

  @@id([orgId, day])
}

/// A request to withdraw an anchored version (CLAUDE.md rule 6): an admin asks,
/// with a reason and a note, and an approver who is someone else approves,
/// which writes a REVOKE row to the journal in the same transaction.
model Revocation {
  id              String           @id @default(cuid())
  reportVersionId String
  reportVersion   ReportVersion    @relation(fields: [reportVersionId], references: [id])
  reason          RevocationReason
  /// Sealed (context `Revocation:<id>:note`): why, in the firm's words. Never on chain.
  note            Bytes
  status          RevocationStatus @default(REQUESTED)
  requestedById   String
  requestedBy     User             @relation("revocationRequestedBy", fields: [requestedById], references: [id])
  requestedAt     DateTime         @default(now())
  /// Never the requester: a CHECK in the migration enforces it.
  approvedById    String?
  approvedBy      User?            @relation("revocationApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  /// Who rejected or withdrew it, and when. A CANCELLED one has a time and no person: the owner cancelled it on chain.
  closedById      String?
  closedBy        User?            @relation("revocationClosedBy", fields: [closedById], references: [id])
  closedAt        DateTime?
  /// When the request on chain takes effect, unless the owner cancels it first. Set with SCHEDULED.
  effectiveAt     DateTime?
  /// When it took effect: equal to effectiveAt. Set with REVOKED.
  revokedAt       DateTime?

  @@index([reportVersionId])
  @@index([requestedById])
  @@index([approvedById])
  @@index([closedById])
}

/// What the nightly check found when it re-derived a firm's audit chain
/// (scripts/check-audit-chain.ts). Each check also compares the chain with the
/// last intact check, so history that was cut short or rewritten, and then
/// re-hashed so the chain verifies, is still caught.
model AuditChainCheck {
  id          String    @id @default(cuid())
  orgId       String
  org         IssuerOrg @relation(fields: [orgId], references: [id])
  checkedAt   DateTime
  ok          Boolean
  /// Events in the chain, and its last hash, when intact.
  count       Int
  head        String?
  /// The first event that did not verify, and why.
  brokenSeq   Int?
  reason      String?
  /// The firm's audit-log heads on chain that the check held the log to (#94),
  /// and when the latest was written; null when the chain was not read.
  chainHeads  Int?
  chainHeadAt DateTime?

  @@index([orgId, checkedAt])
}

/// Someone who holds a copy of an engagement's report (a lender, a
/// regulator, a shareholder) and is told when a newer version supersedes it.
/// They get a link to the latest version's record, never the report (#8).
model Recipient {
  id            String         @id @default(cuid())
  engagementId  String
  engagement    Engagement     @relation(fields: [engagementId], references: [id])
  name          String
  /// Lower-cased; one live recipient per address and engagement (a partial unique index).
  email         String
  /// en or bg: the language of what they are sent.
  locale        String
  addedById     String
  addedBy       User           @relation("recipientAddedBy", fields: [addedById], references: [id])
  addedAt       DateTime       @default(now())
  /// Removed recipients stay, so who was told what can still be read.
  removedAt     DateTime?
  removedById   String?
  removedBy     User?          @relation("recipientRemovedBy", fields: [removedById], references: [id])
  notifications Notification[]

  @@index([engagementId])
  @@index([addedById])
  @@index([removedById])
}

/// One email to one recipient about one version: a newer version that
/// supersedes theirs, queued in the transaction that makes it COMPLETE, or a
/// version that is revoked, queued in the transaction that makes it REVOKED.
/// Sent by the mailer (scripts/mailer.ts), at least once.
model Notification {
  id              String             @id @default(cuid())
  recipientId     String
  recipient       Recipient          @relation(fields: [recipientId], references: [id])
  /// The version that supersedes theirs (SUPERSEDED), or the revoked one (REVOKED).
  reportVersionId String
  reportVersion   ReportVersion      @relation(fields: [reportVersionId], references: [id])
  kind            NotificationKind   @default(SUPERSEDED)
  status          NotificationStatus @default(PENDING)
  attempts        Int                @default(0)
  /// A name for the last failure, never its message.
  lastError       String?
  leaseUntil      DateTime?
  createdAt       DateTime           @default(now())
  sentAt          DateTime?

  @@unique([recipientId, reportVersionId, kind])
  @@index([reportVersionId])
  @@index([status, leaseUntil])
}

/// A registry write the watch found on chain, by one of the firm's issuer keys.
enum UnjournaledKind {
  ANCHOR
  ANCHOR_COPY
  REVOCATION
  AUDIT_HEAD
}

/// How far the registry watch (#93, scripts/watch-registry.ts) has read the
/// chain for a firm: every event up to `lastBlock`, a finalized block, has
/// been matched to the journal or reported.
model RegistryWatch {
  orgId     String
  org       IssuerOrg @relation(fields: [orgId], references: [id])
  chainId   Int
  registry  String
  lastBlock BigInt
  checkedAt DateTime

  @@id([orgId, chainId, registry])
}

/// A write on chain by one of the firm's issuer keys that no journal row
/// accounts for (#93): a stolen key, or a row lost in a restore. Every chain
/// write the app makes is journalled before it is sent (rule 3), so anything
/// else is reported, and stays reported until an admin has reviewed it.
model UnjournaledWrite {
  id           String          @id @default(cuid())
  orgId        String
  org          IssuerOrg       @relation(fields: [orgId], references: [id])
  chainId      Int
  registry     String
  kind         UnjournaledKind
  recordId     String
  txHash       String
  blockNumber  BigInt
  issuer       String
  /// A revocation: when it takes effect, so the owner's deadline to cancel it.
  effectiveAt  DateTime?
  foundAt      DateTime
  reviewedById String?
  reviewedBy   User?           @relation(fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  @@unique([chainId, registry, txHash, recordId, kind])
  @@index([orgId, reviewedAt])
  @@index([reviewedById])
}

/// A second, independent timestamp of a version's manifest hash, on Bitcoin
/// through OpenTimestamps (#66): the detached proof, as the reference client
/// writes it, kept by `npm run ots` (src/lib/ots/job.ts). Nothing in it is
/// confidential: the manifest hash is on chain already, and the rest is a
/// nonce and hashes.
model OtsProof {
  id               String        @id @default(cuid())
  reportVersionId  String        @unique
  reportVersion    ReportVersion @relation(fields: [reportVersionId], references: [id])
  /// The manifest hash timestamped, 0x hex.
  digest           String        @unique
  /// The .ots file.
  proof            Bytes
  status           OtsStatus     @default(PENDING)
  /// The calendars that took the digest; at least two (a CHECK).
  calendars        String[]
  submittedAt      DateTime
  /// When a pass last asked the calendars or checked Bitcoin.
  checkedAt        DateTime?
  /// A name for why the last pass did not finish it, never a message.
  lastError        String?
  // Set together, with COMPLETE (a CHECK): the earliest block the proof reaches.
  bitcoinHeight    Int?
  bitcoinBlockHash String?
  bitcoinTime      DateTime?
  completedAt      DateTime?

  @@index([status, checkedAt])
}
