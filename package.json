{
  "name": "audit-anchor",
  "version": "0.0.0",
  "private": true,
  "description": "Prototype: anchor audit-report PDFs on a public testnet and verify them in the browser.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "vendor:sync": "node scripts/sync-inflect-ui.mjs",
    "vendor:check": "node scripts/check-vendor.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "contracts:artifact": "node scripts/gen-registry-artifact.mjs",
    "test:pdf": "vitest run --config vitest.pdf.config.mts",
    "test:golden": "vitest run --config vitest.pdf.config.mts tests/pdf/golden.test.ts",
    "fixtures:pdf": "tsx scripts/gen-pdf-fixtures.ts",
    "postinstall": "prisma generate && node scripts/copy-pdf-worker.mjs",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:anchoring": "vitest run --config vitest.anchoring.config.mts",
    "worker": "tsx scripts/worker.ts",
    "audit:check": "tsx scripts/check-audit-chain.ts",
    "monitor": "tsx scripts/monitor.ts",
    "watch:registry": "tsx scripts/watch-registry.ts",
    "mailer": "tsx scripts/mailer.ts",
    "ots": "tsx scripts/ots.ts",
    "reconcile:chain": "tsx scripts/reconcile-chain.ts",
    "test:backup": "scripts/test-backup-restore.sh",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "build:verifier": "tsx scripts/build-verifier.ts",
    "test:tamper": "vitest run --config vitest.tamper.config.mts"
  },
  "bin": {
    "verify-report": "bin/verify-report.mjs"
  },
  "dependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@google-cloud/kms": "6.2.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@tanstack/react-table": "9.2.8",
    "@visx/axis": "4.0.0",
    "@visx/clip-path": "4.0.0",
    "@visx/event": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "@visx/text": "4.0.0",
    "@visx/tooltip": "4.0.0",
    "asn1js": "3.0.10",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-array": "3.2.4",
    "date-fns": "4.4.0",
    "dejavu-fonts-ttf": "2.37.3",
    "lucide-react": "1.61.0",
    "motion": "13.4.4",
    "next": "16.4.2",
    "next-auth": "4.24.15",
    "next-intl": "4.14.9",
    "nodemailer": "10.2.1",
    "otplib": "13.5.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "pkijs": "3.4.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "viem": "2.57.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@noble/curves": "1.9.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-array": "3.2.2",
    "@types/node": "26.6.5",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "jsqr": "1.4.0",
    "pdfkit": "0.20.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "nodemailer": "$nodemailer"
  }
}
