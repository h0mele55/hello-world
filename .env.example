# Names only. Values live in the environment's secrets or a local .env, never in git.

# Phase 1: deploying the registry (npx tsx scripts/deploy-registry.ts sepolia)
DEPLOYER_PRIVATE_KEY=
ISSUER_ADDRESS=
ISSUER_ORG_NAME=
ETHERSCAN_API_KEY=

# Phase 1+: talking to Sepolia
SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL_2=
ISSUER_PRIVATE_KEY=

# Phase 2: the app. docker-compose.yml runs Postgres with POSTGRES_PASSWORD;
# DATABASE_URL is then postgresql://anchor:<that password>@127.0.0.1:5432/anchor
POSTGRES_PASSWORD=
DATABASE_URL=
# Base64 of at least 32 random bytes: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# Base64 of exactly 32 random bytes; FILE_ENCRYPTION_KEY_VERSION names it (default 1)
FILE_ENCRYPTION_KEY=
FILE_ENCRYPTION_KEY_VERSION=
# Where encrypted PDFs are written (default ./storage, git-ignored)
FILE_STORAGE_DIR=
# Base64 of at least 32 random bytes; keys the pseudonymous family ids
ISSUER_FAMILY_SECRET=
# 1 only behind a proxy that overwrites X-Forwarded-For
TRUST_PROXY_HEADERS=

# Phase 2: npm run db:seed
SEED_ORG_NAME=
SEED_PREPARER_EMAIL=
SEED_PREPARER_PASSWORD=
SEED_APPROVER_EMAIL=
SEED_APPROVER_PASSWORD=

# Phase 2: npm run test:db (the database name must end in _test)
TEST_DATABASE_URL=
